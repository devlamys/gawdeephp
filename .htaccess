Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect external requests for *.php (except admin, api and cron) to clean extensionless URLs
    RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.php[\s?] [NC]
    RewriteCond %{REQUEST_URI} !^/(?:admin|api|cron)/ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Special route for sitemap.xml
    RewriteRule ^sitemap\.xml$ sitemap.php [L,NC]

    # Block direct access to storage and includes
    RewriteRule ^(?:storage|includes)/ - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]

    # Internally route clean extensionless URLs to corresponding .php file if it exists (supports single and multi-level paths)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.+)$ $1.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_php7.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 120
</IfModule>
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 70M
    php_value max_execution_time 120
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
# Manual editing of this file may result in unexpected behavior.
# To make changes to this file, use the cPanel MultiPHP INI Editor (Home >> Software >> MultiPHP INI Editor)
# For more information, read our documentation (https://go.cpanel.net/EA4ModifyINI)
<IfModule php8_module>
    php_value error_log "/home/mixmepowder/logs/php.error.log"
    php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
    php_value error_log "/home/mixmepowder/logs/php.error.log"
    php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
    AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit