# =====================================================================
# Gawdee Storefront - Environment Configuration
# Copy this file to .env and fill in your details for cPanel / Production
# =====================================================================

APP_NAME="Gawdee Storefront"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/gawdeeNew

# Database Driver: 'mysql' for cPanel / MySQL server, or 'sqlite' for local file DB
DB_DRIVER=mysql

# MySQL Configuration (Required when DB_DRIVER=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cpaneluser_gawdee
DB_USER=cpaneluser_gawdeeuser
DB_PASSWORD=your_secure_database_password
DB_CHARSET=utf8mb4

# SQLite Configuration (Used when DB_DRIVER=sqlite)
DB_FILE=storage/gawdee.sqlite

# Security Secret (Random string for encryption / session security)
SESSION_SECRET=change_this_to_a_long_random_secret_string

# Payment Gateway - Razorpay (Optional - can also be set in Admin Panel)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# AI & Integrations (Optional)
GROQ_API_KEY=
OPENAI_API_KEY=
