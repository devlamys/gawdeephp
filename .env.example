# Gawdee Environment Configuration

# Database Driver: 'mysql' for XAMPP / MariaDB, 'sqlite' for file-based SQLite database
DB_DRIVER=mysql

# MySQL Settings (Local XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gawdee
DB_USERNAME=root
DB_PASSWORD=

# SQLite Settings (Used if DB_DRIVER=sqlite)
DB_SQLITE_PATH=storage/gawdee.sqlite

# Application Key (Optional, auto-generated if empty)
GAWDEE_APP_KEY=
