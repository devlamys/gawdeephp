# Gawdee Environment Configuration

# Set DB_DRIVER to 'mysql' (for XAMPP) or 'sqlite'
DB_DRIVER=mysql

# MySQL Configuration (XAMPP Default)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gawdee
DB_USERNAME=root
DB_PASSWORD=

# SQLite Configuration (Used if DB_DRIVER=sqlite)
DB_SQLITE_PATH=storage/gawdee.sqlite